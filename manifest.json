{
  "manifest_version": 3,
  "name": "ChatGPT Hashtag Templates & PDF Export",
  "version": "1.0.0",
  "description": "Add hashtag templates and PDF export to ChatGPT",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["templates.json"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}